# IDE and local editor state
**/.vs/
**/*.user
**/*.suo

# Local development snapshots. These are intentionally excluded from the
# shared repository and must never be staged or published.
/DragonSwordWorldRadar-Dev/
/DragonSwordWorldRadar-Mole/
/radar-minimap-tests-docs.patch

# Per-project build and release output
**/bin/
**/obj/
**/dist/

# Disposable local verification and native build workspaces
/.installer-tests/
/.release-validation/
/.tmp/
**/.tmp/
**/build-*/
/DragonSwordNativeAutoPickup/build/
**/installer/build/

# Installed/runtime state and diagnostics
**/runtime/
**/*.log
**/*-Diagnostics-*.zip
**/*_last_stage.txt
**/metadata/install-state.json
**/metadata/datasets.json
**/data/generated/*.lua
**/data/treasure_overrides.txt

# Native all-mount research contains extracted/cooked game assets and local
# verification copies. Publish only its implementation, metadata, and tools.
/DragonSwordNativeAllMountsFreeFlight/analysis/
/DragonSwordNativeAllMountsFreeFlight/backups/
/DragonSwordNativeAllMountsFreeFlight/source/
/DragonSwordNativeAllMountsFreeFlight/staging/

# Local archive snapshots are not repository source.
/*.zip
/*/*.zip

# Local release-build tool copies excluded by individual project policy.
Archive/DragonSwordWorldRadar/vendor/ooz/ooz.exe
**/PakReaderCore.exe
**/ooz.exe

# Local game data, extracted packages, databases, dumps, and credentials.
**/*.pak
**/*.ucas
**/*.utoc
**/*.db
**/*.sqlite
**/*.dmp
**/*.key
**/CrashContext.runtime-xml
