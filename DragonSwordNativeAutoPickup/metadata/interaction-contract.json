{
  "schema_version": 4,
  "status": "OWNER_AUTHORIZED_RUNTIME_CANARY",
  "active_mode_approved": true,
  "active_mode_scope": "exact F9 runtime canary on trusted fingerprints only",
  "runtime_acceptance": false,
  "pulse_function": "/Script/Engine.PlayerController:ServerRecvClientInputFrame",
  "pulse_interval_ms": 150,
  "pulse_absence_policy": "fail_closed_no_scan_no_tick_fallback",
  "allowed_class": "/Script/DS.DropItemActor",
  "required_interactable_value": 2,
  "required_interact_type": 7,
  "required_player_class": "/Script/DS.DsPlayerCharacter",
  "required_controller_class": "/Script/DS.DsPlayerController",
  "required_identity_rule": "controller.Pawn == player && player.Controller == controller",
  "interaction": {
    "function": "/Script/DS.DInteractableComponent:Server_InputInteractKeyAction",
    "key_action": 13,
    "owner_authorized": true
  },
  "activation_rule": "armed && trusted_fingerprint && fresh_accepted_input_frame_pulse",
  "candidate_rule": "exact DropItemActor lifecycle capture as FWeakObjectPtr; gameplay reads only on an accepted pulse",
  "world_transition_rule": "clear candidates and fail closed until a fresh accepted input-frame pulse",
  "unknown_build_policy": "passive_off"
}
